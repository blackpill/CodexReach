{
  "name": "codexreach",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/server.js",
    "test": "vitest run --config vitest.config.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:all": "npm test && npm run test:worker && npm run test:hermes",
    "check:worker": "tsc -p worker/tsconfig.json",
    "check:all": "npm run check && npm run check:worker",
    "test:hermes": "python3 -m unittest discover -s integrations/hermes -p \"test_*.py\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.2.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
