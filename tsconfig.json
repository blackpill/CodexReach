{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "rootDir": ".", "outDir": "dist", "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts", "web/**/*.ts", "web/**/*.tsx", "vite.config.ts"]
}
