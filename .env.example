HOST=0.0.0.0
PORT=4317
CODEX_BIN=codex
# 飞书开放平台自建应用凭据；留空时只启动网页控制台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 逗号分隔的飞书 open_id；强烈建议配置
FEISHU_ALLOWED_OPEN_IDS=
# 任务连续无 Codex 事件后自动停止；0 表示关闭
FEISHU_IDLE_TIMEOUT_MINUTES=15
# Codex Desktop 会话增量同步到飞书的轮询间隔（秒，最小 5 秒）
FEISHU_DESKTOP_SYNC_INTERVAL_SECONDS=10
# SQLite 状态库；保存飞书映射、同步游标及 Session/Turn/event_id 关联
CODEXREACH_STATE_DB=.data/feishu-state.sqlite
# .data/logs 中结构化日志的保留天数
LOG_RETENTION_DAYS=14

# 通用后续评估系统；试点前保持关闭。开启后会分析新完成的 Codex 回合并保存行动候选。
EVALUATION_SYSTEM_ENABLED=false
# 逗号分隔的试点项目绝对路径；留空表示允许所有项目。
EVALUATION_PROJECT_PATHS=
# 自动创建的评估任务默认负责人；留空时使用 FEISHU_ALLOWED_OPEN_IDS 中第一位用户。
EVALUATION_DEFAULT_ASSIGNEE_OPEN_ID=
# 到期扫描间隔（秒，最小 5 秒）。
EVALUATION_SCHEDULER_INTERVAL_SECONDS=86400
# 当前“Codex 项目进展追踪”Base 及评估表 ID；未完整配置时跳过 Base 同步。
EVALUATION_BASE_TOKEN=
EVALUATION_BASE_PROJECT_TABLE_ID=
EVALUATION_BASE_ACTION_TABLE_ID=
EVALUATION_BASE_PLAN_TABLE_ID=
EVALUATION_BASE_RESULT_TABLE_ID=

# GitHub Issue Auto：试点专用，默认关闭。启用前须先部署/测试 Worker 和配置项目群、CI。
ISSUE_AUTO_ENABLED=false
# 启用将允许 Codex 以当前用户的完整权限执行 Issue 中涉及的代码，仅在理解风险后设置为 true。
ISSUE_AUTO_FULL_ACCESS_ACCEPTED=false
ISSUE_AUTO_QUEUE_URL=
ISSUE_AUTO_QUEUE_SECRET=
ISSUE_AUTO_GITHUB_TOKEN=
# 必须填写已验证的 PR 检查名称（逗号分隔）和 CI 超时分钟数。
ISSUE_AUTO_REQUIRED_CHECKS=
ISSUE_AUTO_CI_TIMEOUT_MINUTES=
# 可改为从权限为 0600 的本地文件读取队列 secret，避免写入环境文件。
ISSUE_AUTO_QUEUE_SECRET_FILE=
# true：启动时从当前用户已登录的 GitHub CLI 获取令牌，不在 .env 保存 token。
ISSUE_AUTO_USE_GH_AUTH=false
# GitHub 仓库 Webhook ID；配置后每 5 分钟检查失败投递并有限次数重投。
ISSUE_AUTO_WEBHOOK_ID=
# 同局域网 PR 静态预览：默认关闭，不发布公网；空 HOST 自动选物理网卡的私网 IPv4。
ISSUE_AUTO_LAN_PREVIEW_ENABLED=false
ISSUE_AUTO_PREVIEW_HOST=
ISSUE_AUTO_PREVIEW_FIRST_PORT=8800
ISSUE_AUTO_PREVIEW_MAX=5
# 关键事件：Topic 留档＋机器人单聊；默认关闭，仅发送给明确允许的一个用户。
ISSUE_AUTO_DM_NOTIFY_ENABLED=false
# 留空仅在 FEISHU_ALLOWED_OPEN_IDS 恰好一个用户时自动选择；不会向多人广播。
ISSUE_AUTO_NOTIFY_OPEN_ID=

# Optional trusted operator JSON; overrides the legacy single-usmap project fields.
# Only enabled:true entries are claimed. See docs/issue-auto-multi-project.md.
# Do NOT enable classgames until its main branch contains a verified PR CI workflow.
ISSUE_AUTO_PROJECTS_JSON=
