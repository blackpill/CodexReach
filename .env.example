HOST=0.0.0.0
PORT=4317
CODEX_BIN=codex
# 飞书开放平台自建应用凭据；留空时只启动网页控制台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 逗号分隔的飞书 open_id；强烈建议配置
FEISHU_ALLOWED_OPEN_IDS=
# 任务连续无 Codex 事件后自动停止；0 表示关闭
FEISHU_IDLE_TIMEOUT_MINUTES=15
# Codex Desktop 会话增量同步到飞书的轮询间隔（秒，最小 5 秒）
FEISHU_DESKTOP_SYNC_INTERVAL_SECONDS=10
# SQLite 状态库；保存飞书映射、同步游标及 Session/Turn/event_id 关联
CODEXREACH_STATE_DB=.data/feishu-state.sqlite
# .data/logs 中结构化日志的保留天数
LOG_RETENTION_DAYS=14

# 通用后续评估系统；试点前保持关闭。开启后会分析新完成的 Codex 回合并保存行动候选。
EVALUATION_SYSTEM_ENABLED=false
